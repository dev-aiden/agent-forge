{
  "name": "agent-forge",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "scan": "tsx packages/adapters/scripts/scan.ts",
    "test": "tsx --test \"packages/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && npm run typecheck -w @agent-forge/desktop",
    "dev": "npm run dev -w @agent-forge/desktop",
    "smoke": "npm run smoke -w @agent-forge/desktop",
    "read": "tsx packages/adapters/scripts/read.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
